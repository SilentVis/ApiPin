@* Workspace header, filter and the collections tree, with drag-and-drop to reorder and move. *@
@inject WorkspaceState State
@inject UiActions Actions
@inject Overlays Overlays
@implements IDisposable

<aside class="sidebar">
    <div class="sidebar-head">
        <span class="workspace-name" title="@State.Workspace?.Root">@(State.Workspace?.Name ?? "No workspace")</span>
        <span class="spacer"></span>
        <button class="icon-btn" title="New collection" disabled="@(State.Workspace is null)" @onclick="Actions.NewCollectionAsync">＋</button>
        <button class="icon-btn" title="Workspace" @onclick='() => ToggleMenu(WorkspaceMenu)'>⋯</button>
        @if (_menu == WorkspaceMenu)
        {
            <div class="menu" role="menu">
                <button class="menu-item" role="menuitem" @onclick="() => Run(Actions.OpenWorkspaceAsync)">Open or create workspace folder…</button>
                <button class="menu-item" role="menuitem" @onclick="() => Run(() => { State.Reload(); return Task.CompletedTask; })">Reload from disk</button>
                <button class="menu-item" role="menuitem" @onclick="() => Run(() => { Overlays.Show(Overlay.Import); return Task.CompletedTask; })">Import: Postman, OpenAPI, cURL…</button>
                @if (State.RecentWorkspaces is { Count: > 0 } recent)
                {
                    <div class="menu-sep">Recent</div>
                    @foreach (var path in recent)
                    {
                        <div class="menu-recent">
                            <button class="menu-item" role="menuitem" title="@path" @onclick="() => Run(() => { State.OpenWorkspace(path); return Task.CompletedTask; })">
                                <span>@Path.GetFileName(Path.TrimEndingDirectorySeparator(path))</span>
                                <span class="muted menu-path">@path</span>
                            </button>
                            <button class="icon-btn" title="Remove from list" @onclick="() => State.ForgetRecent(path)" @onclick:stopPropagation="true">✕</button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    @if (State.Error is { } error)
    {
        <div class="banner error">
            <span>@error</span>
            <button class="icon-btn" title="Dismiss" @onclick="State.DismissError">✕</button>
        </div>
    }

    <div class="segmented sidebar-views">
        <button class="@(_view == "collections" ? "active" : null)" @onclick='() => _view = "collections"'>Collections</button>
        <button class="@(_view == "history" ? "active" : null)" @onclick='() => _view = "history"'>History</button>
    </div>

    @if (_view == "history")
    {
        <HistoryPanel />
    }
    else if (State.Workspace is { } workspace)
    {
        <input class="sidebar-filter" type="search" placeholder="Filter requests" value="@_filter" @oninput="e => _filter = e.Value?.ToString() ?? string.Empty" />

        @if (workspace.Problems.Count > 0)
        {
            <div class="banner warn" title="@string.Join(Environment.NewLine, workspace.Problems.Select(p => $"{p.Path}: {p.Message}"))">
                @workspace.Problems.Count file@(workspace.Problems.Count == 1 ? "" : "s") skipped (hover for details)
            </div>
        }

        <div class="tree @(_drag is not null ? "dragging" : null)" role="tree">
            @if (workspace.Collections.Count == 0)
            {
                <div class="tree-empty">
                    <p class="hint">No collections yet.</p>
                    <button class="btn" @onclick="Actions.NewCollectionAsync">New collection</button>
                    <p class="hint">Or press <kbd>Ctrl</kbd> + <kbd>S</kbd> in a tab to save it into a new one.</p>
                </div>
            }
            @foreach (var collection in workspace.OrderedCollections.Where(Visible))
            {
                @FolderNode(collection, 0)
            }
            @if (Filtering && !workspace.Collections.Any(Visible))
            {
                <p class="hint tree-empty">No requests match '@_filter'.</p>
            }
        </div>

        <div class="sidebar-foot muted" title="@workspace.Root">@workspace.Root</div>
    }
</aside>

@if (_menu is not null)
{
    <div class="menu-backdrop" @onclick="() => _menu = null"></div>
}

@code {
    private static readonly Guid WorkspaceMenu = Guid.Empty;
    private const double RowHeight = 28;

    private enum DropPosition { Before, Into, After }

    private readonly HashSet<Guid> _expanded = [];
    private Guid? _menu;
    private string _view = "collections";

    /// <summary>Switches between the collections tree and history (command palette).</summary>
    public void ShowView(string view)
    {
        _view = view;
        StateHasChanged();
    }
    private string _filter = "";

    // Drag and drop: the item being dragged and where it would land.
    private object? _drag;
    private (object Target, DropPosition Position)? _drop;
    private bool _skipRender;

    private bool Filtering => _filter.Trim().Length > 0;

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    public void Dispose() => State.Changed -= OnStateChanged;

    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    private void OnStateChanged()
    {
        // Reveal the active saved request in the tree.
        if (State.Find(State.Active.Request.Id) is { } location)
            foreach (var folder in location.Path) _expanded.Add(folder.Id);
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu(Guid id) => _menu = _menu == id ? null : id;

    private bool Matches(RequestDefinition r) =>
        !Filtering ||
        r.Name.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase) ||
        r.Url.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool Visible(RequestFolder folder) =>
        !Filtering || folder.Name.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase) || folder.AllRequests().Any(Matches);

    private bool IsExpanded(RequestFolder folder) => Filtering || _expanded.Contains(folder.Id);

    private void Toggle(RequestFolder folder)
    {
        if (!_expanded.Remove(folder.Id)) _expanded.Add(folder.Id);
    }

    private async Task Run(Func<Task> action)
    {
        _menu = null;
        await action();
    }

    private async Task NewFolder(RequestFolder parent)
    {
        _menu = null;
        if (await Actions.NewFolderAsync(parent) is { } folder)
        {
            _expanded.Add(parent.Id);
            _expanded.Add(folder.Id);
        }
    }

    private void NewRequest(RequestFolder parent)
    {
        _menu = null;
        _expanded.Add(parent.Id);
        State.CreateRequest(parent);
    }

    // ---------- Drag and drop ----------

    private void DragStart(object item)
    {
        _drag = item;
        _drop = null;
        _menu = null;
    }

    private void DragEnd()
    {
        _drag = null;
        _drop = null;
    }

    /// <summary>Where the dragged item would land on <paramref name="target"/>, or null when it can't go there.</summary>
    private DropPosition? PositionFor(object target, double offsetY)
    {
        var top = offsetY < RowHeight / 2;
        switch (_drag, target)
        {
            case (RequestCollection, RequestCollection t) when !ReferenceEquals(_drag, t):
                return top ? DropPosition.Before : DropPosition.After;
            case (RequestCollection, _):
                return null;

            case (RequestDefinition r, RequestDefinition t) when !ReferenceEquals(r, t):
                return top ? DropPosition.Before : DropPosition.After;
            case (RequestDefinition, RequestFolder):
                return DropPosition.Into;

            case (RequestFolder f, RequestCollection t) when WorkspaceState.CanMove(f, t):
                return DropPosition.Into;
            case (RequestFolder f, RequestFolder t) when !ReferenceEquals(f, t) && State.ParentOf(t) is { } parent && WorkspaceState.CanMove(f, parent):
                return offsetY < RowHeight * .3 ? DropPosition.Before
                    : offsetY > RowHeight * .7 ? DropPosition.After
                    : WorkspaceState.CanMove(f, t) ? DropPosition.Into : null;

            default:
                return null;
        }
    }

    private void DragOver(DragEventArgs e, object target)
    {
        var position = _drag is null ? null : PositionFor(target, e.OffsetY);
        (object, DropPosition)? next = position is { } p ? (target, p) : null;
        if (Equals(next, _drop))
        {
            _skipRender = true; // dragover fires continuously; only re-render when the marker moves
            return;
        }
        _drop = next;
    }

    private void Drop(object target)
    {
        var (drag, drop) = (_drag, _drop);
        DragEnd();
        if (drag is null || drop is not { } d || !ReferenceEquals(d.Target, target)) return;

        switch (drag, target)
        {
            case (RequestCollection c, RequestCollection t):
                State.Move(c, IndexAmong(State.Workspace!.OrderedCollections.ToList(), c, t, d.Position));
                break;

            case (RequestDefinition r, RequestDefinition t) when State.Find(t.Id) is { } location:
                State.Move(r, location.Parent, IndexAmong(location.Parent.OrderedRequests.ToList(), r, t, d.Position));
                break;

            case (RequestDefinition r, RequestFolder f):
                _expanded.Add(f.Id);
                State.Move(r, f, int.MaxValue);
                break;

            case (RequestFolder f, RequestFolder t) when d.Position == DropPosition.Into:
                _expanded.Add(t.Id);
                State.Move(f, t, int.MaxValue);
                break;

            case (RequestFolder f, RequestFolder t) when State.ParentOf(t) is { } parent:
                State.Move(f, parent, IndexAmong(parent.OrderedFolders.ToList(), f, t, d.Position));
                break;
        }
    }

    /// <summary>The insert index next to <paramref name="target"/>, counted without the item being moved.</summary>
    private static int IndexAmong<T>(List<T> siblings, T moving, T target, DropPosition position) where T : class
    {
        siblings.Remove(moving);
        var index = siblings.IndexOf(target);
        return index < 0 ? siblings.Count : position == DropPosition.After ? index + 1 : index;
    }

    private string? DropClass(object target) =>
        _drop is { } d && ReferenceEquals(d.Target, target)
            ? d.Position switch { DropPosition.Before => "drop-before", DropPosition.After => "drop-after", _ => "drop-into" }
            : null;

    // ---------- Rendering ----------

    private RenderFragment Menu(params (string Label, Func<Task> Action)[] items) => __builder =>
    {
        <div class="menu" role="menu">
            @foreach (var (label, action) in items)
            {
                <button class="menu-item @(label.StartsWith("Delete") ? "danger" : null)" role="menuitem" @onclick="() => Run(action)">@label</button>
            }
        </div>
    };

    private RenderFragment FolderNode(RequestFolder folder, int depth) => __builder =>
    {
        var expanded = IsExpanded(folder);
        var isCollection = folder is RequestCollection;
        <div class="tree-row @(isCollection ? "collection" : "folder") @DropClass(folder) @(ReferenceEquals(_drag, folder) ? "drag-source" : null)"
             style="--depth:@depth" role="treeitem" aria-expanded="@(expanded ? "true" : "false")"
             draggable="@(Filtering ? "false" : "true")"
             @ondragstart="() => DragStart(folder)" @ondragend="DragEnd"
             @ondragover="e => DragOver(e, folder)" @ondragover:preventDefault="true" @ondrop="() => Drop(folder)" @ondrop:preventDefault="true"
             @onclick="() => Toggle(folder)" title="@folder.Name">
            <span class="chevron @(expanded ? "open" : null)">▸</span>
            <span class="node-icon">@(isCollection ? "▤" : "▭")</span>
            <span class="node-name">@folder.Name</span>
            @if (folder.HasSettings)
            {
                <span class="settings-mark" title="Has its own headers, auth or variables">⚙</span>
            }
            <button class="icon-btn row-action" title="More" @onclick="() => ToggleMenu(folder.Id)" @onclick:stopPropagation="true">⋯</button>
            @if (_menu == folder.Id)
            {
                <div @onclick:stopPropagation="true">
                    @if (folder is RequestCollection collection)
                    {
                        @Menu(
                            ("Run collection…", () => { Overlays.Show(Overlay.Runner, folder.Id.ToString()); return Task.CompletedTask; }),
                            ("New request", () => { NewRequest(folder); return Task.CompletedTask; }),
                            ("New folder", () => NewFolder(folder)),
                            ("Settings: headers, auth, variables…", () => Actions.EditSettingsAsync(folder)),
                            ("Rename…", () => Actions.RenameAsync(folder)),
                            ("Export as Postman v2.1…", () => Actions.ExportPostmanAsync(collection)),
                            ("Delete…", () => Actions.DeleteAsync(folder)))
                    }
                    else
                    {
                        @Menu(
                            ("Run folder…", () => { Overlays.Show(Overlay.Runner, folder.Id.ToString()); return Task.CompletedTask; }),
                            ("New request", () => { NewRequest(folder); return Task.CompletedTask; }),
                            ("New folder", () => NewFolder(folder)),
                            ("Settings: headers, auth, variables…", () => Actions.EditSettingsAsync(folder)),
                            ("Rename…", () => Actions.RenameAsync(folder)),
                            ("Delete…", () => Actions.DeleteAsync(folder)))
                    }
                </div>
            }
        </div>

        @if (expanded)
        {
            @foreach (var sub in folder.OrderedFolders.Where(Visible))
            {
                @FolderNode(sub, depth + 1)
            }
            @foreach (var request in folder.OrderedRequests.Where(Matches))
            {
                @RequestNode(request, depth + 1)
            }
            @if (!Filtering && folder.Folders.Count == 0 && folder.Requests.Count == 0)
            {
                <div class="tree-row empty" style="--depth:@(depth + 1)">
                    <button class="link-btn" @onclick="() => NewRequest(folder)">Add a request</button>
                </div>
            }
        }
    };

    private RenderFragment RequestNode(RequestDefinition request, int depth) => __builder =>
    {
        var tab = State.Tabs.FirstOrDefault(t => t.Request.Id == request.Id);
        var active = ReferenceEquals(tab, State.Active);
        <div class="tree-row request @(active ? "active" : null) @DropClass(request) @(ReferenceEquals(_drag, request) ? "drag-source" : null)"
             style="--depth:@depth" role="treeitem" title="@request.Url"
             draggable="@(Filtering ? "false" : "true")"
             @ondragstart="() => DragStart(request)" @ondragend="DragEnd"
             @ondragover="e => DragOver(e, request)" @ondragover:preventDefault="true" @ondrop="() => Drop(request)" @ondrop:preventDefault="true"
             @onclick="() => State.Open(request)">
            <span class="method-badge @Display.MethodClass(request.Method)">@Display.ShortMethod(request.Method)</span>
            <span class="node-name">@(string.IsNullOrWhiteSpace(request.Name) ? request.Url : request.Name)</span>
            @if (tab?.IsModified == true)
            {
                <span class="modified-dot" title="Unsaved changes"></span>
            }
            <button class="icon-btn row-action" title="More" @onclick="() => ToggleMenu(request.Id)" @onclick:stopPropagation="true">⋯</button>
            @if (_menu == request.Id)
            {
                <div @onclick:stopPropagation="true">
                    @Menu(
                        ("Open", () => { State.Open(request); return Task.CompletedTask; }),
                        ("Rename…", () => Actions.RenameAsync(request)),
                        ("Duplicate", () => { State.DuplicateSaved(request); return Task.CompletedTask; }),
                        ("Delete…", () => Actions.DeleteAsync(request)))
                </div>
            }
        </div>
    };
}
