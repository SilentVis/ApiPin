@* Auth settings of a request, folder or collection. *@
@using ApiPin.Core.Execution

<div class="form">
    <label class="field">
        <span>Type</span>
        <select value="@TypeKey(Auth)" @onchange="OnTypeChanged">
            @if (AllowInherit)
            {
                <option value="inherit">Inherit from parent</option>
            }
            <option value="none">No auth</option>
            <option value="basic">Basic</option>
            <option value="bearer">Bearer token</option>
            <option value="apikey">API key</option>
            <option value="oauth2">OAuth 2.0</option>
            <option value="azurecli">Azure CLI token (Entra ID)</option>
            <option value="windows">Windows (Negotiate / NTLM)</option>
        </select>
    </label>

    @switch (Auth)
    {
        case InheritAuth:
            @if (Inherited?.From is { } from)
            {
                <p class="hint">
                    Uses <b>@Describe(Inherited.Auth)</b> from @(from is RequestCollection ? "collection" : "folder") <b>@from.Name</b>.
                </p>
            }
            else
            {
                <p class="hint">@(HasParent ? "No folder or collection above sets auth, so this is sent without auth." : "Not saved in a collection, so this is sent without auth.")</p>
            }
            break;

        case NoAuth:
            <p class="hint">@(AllowInherit ? "Sent without authorization." : "Requests inside are sent without authorization unless they or a folder set it.")</p>
            break;

        case BasicAuth basic:
            <label class="field">
                <span>Username</span>
                <input value="@basic.Username" spellcheck="false" autocomplete="off" @oninput="e => Set(() => basic.Username = Str(e))" />
            </label>
            <SecretField Label="Password" Value="@basic.Password" ValueChanged="v => Set(() => basic.Password = v)" />
            break;

        case BearerAuth bearer:
            <label class="field top">
                <span>Token</span>
                <textarea class="code-input" rows="4" spellcheck="false" value="@bearer.Token" @oninput="e => Set(() => bearer.Token = Str(e))"></textarea>
            </label>
            <label class="field">
                <span>Prefix</span>
                <input value="@bearer.Prefix" spellcheck="false" placeholder="(none)" @oninput="e => Set(() => bearer.Prefix = Str(e))" />
            </label>
            <p class="hint">Sent as <code>Authorization: @(string.IsNullOrWhiteSpace(bearer.Prefix) ? "" : bearer.Prefix.Trim() + " ")&lt;token&gt;</code></p>
            break;

        case ApiKeyAuth apiKey:
            <label class="field">
                <span>Key</span>
                <input value="@apiKey.Key" spellcheck="false" @oninput="e => Set(() => apiKey.Key = Str(e))" />
            </label>
            <SecretField Label="Value" Value="@apiKey.Value" ValueChanged="v => Set(() => apiKey.Value = v)" />
            <label class="field">
                <span>Add to</span>
                <select value="@apiKey.Location" @onchange="e => Set(() => apiKey.Location = Enum.Parse<ApiKeyLocation>(Str(e)))">
                    <option value="@ApiKeyLocation.Header">Header</option>
                    <option value="@ApiKeyLocation.Query">Query parameter</option>
                </select>
            </label>
            break;

        case OAuth2Auth oauth:
            <label class="field">
                <span>Grant type</span>
                <select value="@oauth.GrantType" @onchange="e => Set(() => oauth.GrantType = Enum.Parse<OAuth2GrantType>(Str(e)))">
                    <option value="@OAuth2GrantType.ClientCredentials">Client credentials</option>
                    <option value="@OAuth2GrantType.AuthorizationCode">Authorization code (browser sign-in)</option>
                    <option value="@OAuth2GrantType.Password">Password (legacy)</option>
                </select>
            </label>
            @if (oauth.GrantType == OAuth2GrantType.AuthorizationCode)
            {
                @Text("Authorization URL", oauth.AuthorizationUrl, v => oauth.AuthorizationUrl = v, "https://login.example.com/oauth2/authorize")
            }
            @Text("Token URL", oauth.TokenUrl, v => oauth.TokenUrl = v, "https://login.example.com/oauth2/token")
            @Text("Client ID", oauth.ClientId, v => oauth.ClientId = v)
            <SecretField Label="Client secret" Value="@oauth.ClientSecret" ValueChanged="v => Set(() => oauth.ClientSecret = v)" />
            @Text("Scope", oauth.Scope, v => oauth.Scope = v, "space-separated, e.g. orders.read offline_access")
            @Text("Audience", oauth.Audience, v => oauth.Audience = v, "optional")
            @if (oauth.GrantType == OAuth2GrantType.Password)
            {
                @Text("Username", oauth.Username, v => oauth.Username = v)
                <SecretField Label="Password" Value="@oauth.Password" ValueChanged="v => Set(() => oauth.Password = v)" />
            }
            @if (oauth.GrantType == OAuth2GrantType.AuthorizationCode)
            {
                @Text("Redirect URI", oauth.RedirectUri, v => oauth.RedirectUri = v, OAuth2Auth.DefaultRedirectUri)
                <label class="check">
                    <input type="checkbox" checked="@oauth.UsePkce" @onchange="e => Set(() => oauth.UsePkce = e.Value is true)" />
                    Use PKCE (S256)
                </label>
            }
            <label class="field">
                <span>Client auth</span>
                <select value="@oauth.ClientAuthentication" @onchange="e => Set(() => oauth.ClientAuthentication = Enum.Parse<OAuth2ClientAuthentication>(Str(e)))">
                    <option value="@OAuth2ClientAuthentication.BasicHeader">Send as Basic auth header</option>
                    <option value="@OAuth2ClientAuthentication.Body">Send in the request body</option>
                </select>
            </label>
            @Text("Header prefix", oauth.HeaderPrefix, v => oauth.HeaderPrefix = v, "Bearer")
            <p class="hint">
                @(oauth.GrantType == OAuth2GrantType.AuthorizationCode
                    ? $"Sign-in opens in your browser; ApiPin listens on the redirect URI for the response. Register {(string.IsNullOrWhiteSpace(oauth.RedirectUri) ? OAuth2Auth.DefaultRedirectUri : oauth.RedirectUri)} with the provider."
                    : "The token is fetched on the first send, cached until it expires and refreshed automatically.")
            </p>
            break;

        case AzureCliAuth azure:
            @Text("Resource", azure.Resource, v => azure.Resource = v, "api://my-api, an app ID, or a scope ending in /.default")
            @Text("Tenant", azure.Tenant, v => azure.Tenant = v, "optional: tenant ID or domain")
            <p class="hint">Runs <code>az account get-access-token</code> as you; sign in once with <code>az login</code>. The token is cached until it expires.</p>
            break;

        case WindowsAuth windows:
            <label class="check">
                <input type="checkbox" checked="@windows.UseCurrentUser" @onchange="e => Set(() => windows.UseCurrentUser = e.Value is true)" />
                Use the current Windows user (@Environment.UserDomainName\@Environment.UserName)
            </label>
            @if (!windows.UseCurrentUser)
            {
                <label class="field">
                    <span>Username</span>
                    <input value="@windows.Username" spellcheck="false" autocomplete="off" @oninput="e => Set(() => windows.Username = Str(e))" />
                </label>
                <SecretField Label="Password" Value="@windows.Password" ValueChanged="v => Set(() => windows.Password = v)" />
                <label class="field">
                    <span>Domain</span>
                    <input value="@windows.Domain" spellcheck="false" @oninput="e => Set(() => windows.Domain = Str(e))" />
                </label>
            }
            <p class="hint">The handshake (Negotiate, Kerberos or NTLM) happens automatically when the server asks for it.</p>
            break;
    }
    @if (Auth is not (InheritAuth or NoAuth))
    {
        <p class="hint">Fields can use <code>{{variables}}</code>.</p>
    }
</div>

@code {
    /// <summary>The auth being edited.</summary>
    [Parameter, EditorRequired] public AuthConfig Auth { get; set; } = null!;

    /// <summary>Called with a new auth object when the type changes.</summary>
    [Parameter] public EventCallback<AuthConfig> AuthChanged { get; set; }

    /// <summary>Called after a field of the current auth was edited in place.</summary>
    [Parameter] public EventCallback OnEdited { get; set; }

    /// <summary>Settings of other types, so switching type and back keeps what was typed.</summary>
    [Parameter] public Dictionary<Type, AuthConfig>? Cache { get; set; }

    [Parameter] public bool AllowInherit { get; set; } = true;

    /// <summary>What "inherit" resolves to, for the explanation.</summary>
    [Parameter] public InheritedAuth? Inherited { get; set; }

    /// <summary>False for a request that isn't saved in a collection.</summary>
    [Parameter] public bool HasParent { get; set; } = true;

    private static string Str(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    private static string TypeKey(AuthConfig auth) => auth switch
    {
        InheritAuth => "inherit",
        BasicAuth => "basic",
        BearerAuth => "bearer",
        ApiKeyAuth => "apikey",
        WindowsAuth => "windows",
        OAuth2Auth => "oauth2",
        AzureCliAuth => "azurecli",
        _ => "none",
    };

    private RenderFragment Text(string label, string value, Action<string> set, string? placeholder = null) => __builder =>
    {
        <label class="field">
            <span>@label</span>
            <input value="@value" placeholder="@placeholder" spellcheck="false" autocomplete="off" @oninput="e => Set(() => set(Str(e)))" />
        </label>
    };

    public static string Describe(AuthConfig auth) => auth switch
    {
        BasicAuth => "Basic auth",
        BearerAuth => "a bearer token",
        ApiKeyAuth k => $"API key '{k.Key}'",
        WindowsAuth => "Windows auth",
        OAuth2Auth o => $"OAuth 2.0 ({o.GrantType switch { OAuth2GrantType.AuthorizationCode => "authorization code", OAuth2GrantType.Password => "password", _ => "client credentials" }})",
        AzureCliAuth => "an Azure CLI token",
        _ => "no auth",
    };

    private Task Set(Action change)
    {
        change();
        return OnEdited.InvokeAsync();
    }

    private Task OnTypeChanged(ChangeEventArgs e)
    {
        if (Cache is not null) Cache[Auth.GetType()] = Auth;

        Type type = Str(e) switch
        {
            "inherit" => typeof(InheritAuth),
            "basic" => typeof(BasicAuth),
            "bearer" => typeof(BearerAuth),
            "apikey" => typeof(ApiKeyAuth),
            "windows" => typeof(WindowsAuth),
            "oauth2" => typeof(OAuth2Auth),
            "azurecli" => typeof(AzureCliAuth),
            _ => typeof(NoAuth),
        };
        var next = Cache is not null && Cache.TryGetValue(type, out var cached) ? cached : (AuthConfig)Activator.CreateInstance(type)!;
        return AuthChanged.InvokeAsync(next);
    }
}
