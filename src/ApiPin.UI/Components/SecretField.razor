<label class="field">
    <span>@Label</span>
    <span class="secret">
        <input type="@(_visible ? "text" : "password")" value="@Value" spellcheck="false" autocomplete="off"
               @oninput="e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" />
        <button class="icon-btn" type="button" title="@(_visible ? "Hide" : "Show")" @onclick="() => _visible = !_visible">@(_visible ? "Hide" : "Show")</button>
    </span>
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool _visible;
}
