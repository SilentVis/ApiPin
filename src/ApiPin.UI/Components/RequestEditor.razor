@using ApiPin.Core.Execution
@inject WorkspaceState State
@inject UiActions Actions
@inject Overlays Overlays

<div class="request-editor">
    <div class="name-row">
        @if (State.Find(Request.Id) is { } location)
        {
            <span class="breadcrumb" title="Saved in @string.Join(" / ", location.Path.Select(f => f.Name))">
                @foreach (var folder in location.Path)
                {
                    <span>@folder.Name</span><span class="sep">/</span>
                }
            </span>
        }
        else
        {
            <span class="badge muted-badge" title="This tab isn't saved in a collection. Press Ctrl+S to save it.">Unsaved</span>
        }
        <input class="name-input" value="@Request.Name" placeholder="@Tab.Title" spellcheck="false" title="Request name"
               @oninput="e => { Request.Name = e.Value?.ToString() ?? string.Empty; State.MarkDirty(); }" />
        @if (Tab.IsModified)
        {
            <span class="modified-dot" title="Unsaved changes"></span>
        }
        <button class="btn ghost" title="Save (Ctrl+S)" disabled="@(State.Workspace is null || (State.IsSaved(Tab) && !Tab.IsModified))"
                @onclick="() => Actions.SaveAsync(Tab)">Save</button>
        <button class="btn ghost" title="Save a copy into a collection (Ctrl+Shift+S)" disabled="@(State.Workspace is null)"
                @onclick="() => Actions.SaveAsAsync(Tab)">Save as…</button>
        <button class="btn ghost" title="Duplicate this request in a new tab" @onclick="() => State.Duplicate(Tab)">Duplicate</button>
        <button class="btn ghost" title="Code snippet: cURL, PowerShell, C#, JavaScript, Python (Ctrl+Shift+C)" @onclick="() => Overlays.Show(Overlay.Snippet)">Code</button>
    </div>

    @if (Tab.HasConflict)
    {
        <div class="banner warn conflict">
            <span>This request changed on disk (for example after a git pull) while you were editing it.</span>
            <button class="btn ghost" @onclick="() => State.UseVersionOnDisk(Tab)">Use the version on disk</button>
            <button class="btn ghost" @onclick="() => State.KeepMyVersion(Tab)">Keep my changes</button>
        </div>
    }

    <div class="request-bar">
        @if (_customMethod)
        {
            <input class="method-input @Display.MethodClass(Request.Method)" value="@Request.Method" placeholder="VERB" spellcheck="false"
                   @onchange="OnCustomMethodChanged" @onblur="() => _customMethod = false" @ref="_methodInput" />
        }
        else
        {
            <select class="method-select @Display.MethodClass(Request.Method)" value="@MethodValue" @onchange="OnMethodChanged" title="HTTP method">
                @foreach (var m in Display.StandardMethods)
                {
                    <option value="@m">@m</option>
                }
                @if (!Display.StandardMethods.Contains(MethodValue))
                {
                    <option value="@MethodValue">@MethodValue</option>
                }
                <option value="@CustomOption">Custom…</option>
            </select>
        }
        <VarInput HostClass="url-host" Class="url-input" Value="@Request.Url" Placeholder="{{baseUrl}}/api/orders/:id?expand=items"
                  Variables="Vars" ValueChanged="OnUrlChanged" />
        @if (Tab.IsSending)
        {
            <button class="btn danger send-btn" @onclick="() => State.Cancel(Tab)">Cancel</button>
        }
        else
        {
            <button class="btn primary send-btn" title="Send (Ctrl+Enter)" @onclick="() => State.SendAsync(Tab)">Send</button>
        }
    </div>

    <nav class="subtabs">
        @Section("params", "Params", ActiveCount(Request.QueryParams) + ActiveCount(Request.PathParams))
        @Section("headers", "Headers", ActiveCount(Request.Headers) + Inherited.Count(h => !h.Overridden))
        @Section("auth", "Auth", EffectiveAuth.Auth is NoAuth ? 0 : 1, dot: true)
        @Section("body", "Body", Request.Body is NoBody ? 0 : 1, dot: true)
        @Section("settings", "Settings", Request.Settings.VerifyTls ? 0 : 1, dot: true)
        @Section("resolved", "Resolved", 0)
    </nav>

    <div class="subtab-body">
        @switch (Tab.RequestSection)
        {
            case "params":
                <h4 class="section-title">Query parameters</h4>
                <KeyValueGrid Items="Request.QueryParams" OnChanged="OnQueryParamsChanged" Variables="Vars" />
                @if (Request.PathParams.Count > 0)
                {
                    <h4 class="section-title">Path parameters</h4>
                    <KeyValueGrid Items="Request.PathParams" OnChanged="State.MarkDirty" AllowAdd="false" KeysReadOnly="true"
                                  KeyHeader="Name" ValuePlaceholder="Value" Variables="Vars" />
                }
                else
                {
                    <p class="hint">Add <code>:name</code> segments to the URL path (e.g. <code>/orders/:id</code>) to fill them in here.</p>
                }
                break;

            case "headers":
                <KeyValueGrid Items="Request.Headers" OnChanged="State.MarkDirty" KeySuggestions="Display.CommonHeaders" KeyPlaceholder="Header" Variables="Vars" />
                @if (Inherited.Count > 0)
                {
                    <h4 class="section-title">Inherited</h4>
                    <table class="table inherited">
                        <tbody>
                            @foreach (var h in Inherited)
                            {
                                <tr class="@(h.Overridden ? "overridden" : null)" title="@(h.Overridden ? "Overridden by a header with the same name closer to this request" : null)">
                                    <td class="mono">@h.Header.Key</td>
                                    <td class="mono wrap">@h.Header.Value</td>
                                    <td class="muted">from @h.From.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <p class="hint">Added automatically unless set here: @string.Join(" · ", AutoHeaders())</p>
                break;

            case "auth":
                <AuthEditor Auth="Request.Auth" AuthChanged="OnAuthChanged" OnEdited="State.MarkDirty" Cache="Tab.AuthCache"
                            Inherited="InheritanceResolver.EffectiveAuth(new InheritAuth(), Chain)" HasParent="Chain.Count > 0" />
                @if (ApiPin.Core.Auth.TokenService.Handles(EffectiveAuth.Auth))
                {
                    <TokenPanel Tab="Tab" />
                }
                break;

            case "body":
                <BodyEditor Tab="Tab" Variables="Vars" />
                break;

            case "settings":
                <SettingsEditor Tab="Tab" />
                break;

            case "resolved":
                <ResolvedPreview Tab="Tab" />
                break;
        }
    </div>
</div>

@code {
    private const string CustomOption = "__custom";

    [Parameter, EditorRequired] public RequestTab Tab { get; set; } = null!;

    private RequestDefinition Request => Tab.Request;
    private IReadOnlyList<RequestFolder> Chain => State.ChainFor(Tab);
    private IReadOnlyList<InheritedHeader> Inherited => InheritanceResolver.InheritedHeaders(Request.Headers, Chain);
    private InheritedAuth EffectiveAuth => InheritanceResolver.EffectiveAuth(Request.Auth, Chain);

    private void OnAuthChanged(AuthConfig auth)
    {
        Request.Auth = auth;
        State.MarkDirty();
    }
    private string MethodValue => Request.Method.Trim().ToUpperInvariant() is { Length: > 0 } m ? m : "GET";

    private bool _customMethod;
    private bool _focusMethod;
    private ElementReference _methodInput;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusMethod && _customMethod)
        {
            _focusMethod = false;
            await _methodInput.FocusAsync();
        }
    }

    private RenderFragment Section(string id, string label, int count, bool dot = false) => __builder =>
    {
        <button class="subtab @(Tab.RequestSection == id ? "active" : null)" @onclick="() => Tab.RequestSection = id">
            @label
            @if (count > 0)
            {
                @if (dot)
                {
                    <span class="dot"></span>
                }
                else
                {
                    <span class="count">@count</span>
                }
            }
        </button>
    };

    private static int ActiveCount(List<KeyValueItem> items) => items.Count(i => i.IsActive);

    private void OnMethodChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "GET";
        if (value == CustomOption)
        {
            _customMethod = true;
            _focusMethod = true;
            return;
        }
        Request.Method = value;
        State.MarkDirty();
    }

    private void OnCustomMethodChanged(ChangeEventArgs e)
    {
        Request.Method = (e.Value?.ToString() ?? "").Trim().ToUpperInvariant();
        _customMethod = false;
        State.MarkDirty();
    }

    private ApiPin.Core.Variables.VariableContext Vars => _vars ??= State.VariablesFor(Tab);
    private ApiPin.Core.Variables.VariableContext? _vars;

    protected override void OnParametersSet() => _vars = null;

    protected override bool ShouldRender()
    {
        _vars = null; // variables may have changed (environment switched, settings saved)
        return true;
    }

    private void OnUrlChanged(string url)
    {
        // Pasting a curl command into the URL bar turns it into the request.
        if (ApiPin.Core.Conversion.CurlParser.LooksLikeCurl(url))
        {
            try
            {
                State.ApplyCurl(Tab, ApiPin.Core.Conversion.CurlParser.Parse(url));
                return;
            }
            catch (ApiPin.Core.Conversion.CurlParseException)
            {
                // Still typing it: keep the text as the URL for now.
            }
        }
        Request.Url = url;
        Request.QueryParams = UrlTools.SyncQueryParams(Request.Url, Request.QueryParams);
        Request.PathParams = UrlTools.SyncPathParams(Request.Url, Request.PathParams);
        State.MarkDirty();
    }

    private void OnQueryParamsChanged()
    {
        Request.Url = UrlTools.WithQuery(Request.Url, Request.QueryParams);
        State.MarkDirty();
    }

    private IEnumerable<string> AutoHeaders()
    {
        bool Has(string name) => Request.Headers.Any(h => h.IsActive && h.Key.Trim().Equals(name, StringComparison.OrdinalIgnoreCase));

        if (!Has("User-Agent")) yield return $"User-Agent: {HttpRequestBuilder.DefaultUserAgent}";
        if (!Has("Accept")) yield return "Accept: */*";
        if (!Has("Content-Type") && ContentTypeFromBody() is { } ct) yield return $"Content-Type: {ct}";
        var auth = EffectiveAuth.Auth;
        if (!Has("Authorization") && auth is BasicAuth or BearerAuth) yield return "Authorization (from Auth tab)";
        if (auth is ApiKeyAuth { Location: ApiKeyLocation.Header } k && k.Key.Length > 0 && !Has(k.Key)) yield return $"{k.Key} (from Auth tab)";
        yield return "Host, Content-Length";
    }

    private string? ContentTypeFromBody() => Request.Body switch
    {
        RawBody raw => raw.MediaType,
        FormUrlEncodedBody => "application/x-www-form-urlencoded",
        MultipartBody => "multipart/form-data",
        BinaryFileBody b => string.IsNullOrWhiteSpace(b.ContentType) ? "from file extension" : b.ContentType,
        _ => null,
    };
}
