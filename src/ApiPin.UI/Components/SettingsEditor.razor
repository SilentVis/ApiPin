@inject WorkspaceState State
@inject IPlatformServices Platform

<div class="form">
    <label class="field">
        <span>Timeout</span>
        <span class="inline">
            <input type="number" min="0" step="1000" class="narrow" value="@Settings.TimeoutMs" @onchange="e => SetInt(e, v => Settings.TimeoutMs = v)" />
            <span class="muted">ms (0 = no timeout)</span>
        </span>
    </label>

    <label class="check">
        <input type="checkbox" checked="@Settings.FollowRedirects" @onchange="e => Set(() => Settings.FollowRedirects = e.Value is true)" />
        Follow redirects
    </label>
    @if (Settings.FollowRedirects)
    {
        <label class="field">
            <span>Max redirects</span>
            <input type="number" min="1" max="50" class="narrow" value="@Settings.MaxRedirects" @onchange="e => SetInt(e, v => Settings.MaxRedirects = Math.Clamp(v, 1, 50))" />
        </label>
    }

    <label class="check">
        <input type="checkbox" checked="@Settings.VerifyTls" @onchange="e => Set(() => Settings.VerifyTls = e.Value is true)" />
        Verify TLS certificate
        @if (!Settings.VerifyTls)
        {
            <span class="badge warn">Off: any certificate is accepted</span>
        }
    </label>

    <label class="field">
        <span>HTTP version</span>
        <select value="@(Settings.HttpVersion ?? "auto")" @onchange="OnVersionChanged">
            <option value="auto">Auto (HTTP/2 if offered)</option>
            <option value="1.1">HTTP/1.1</option>
            <option value="2">HTTP/2</option>
            <option value="3">HTTP/3</option>
        </select>
    </label>

    <h4 class="section-title">Client certificate (mutual TLS)</h4>
    <label class="field">
        <span>Certificate</span>
        <select value="@CertSource" @onchange="OnCertSourceChanged">
            <option value="none">None</option>
            <option value="File">PFX / P12 file</option>
            <option value="Store">Windows certificate store</option>
        </select>
    </label>
    @if (Settings.ClientCertificate is { Source: ClientCertificateSource.File } file)
    {
        <label class="field">
            <span>File</span>
            <span class="file-pick">
                <input value="@file.FilePath" placeholder="C:\certs\client.pfx" spellcheck="false" @oninput="e => Set(() => file.FilePath = e.Value?.ToString() ?? string.Empty)" />
                @if (Platform.SupportsFileDialogs)
                {
                    <button class="btn ghost" @onclick="PickCert">Choose…</button>
                }
            </span>
        </label>
        <SecretField Label="Password" Value="@file.Password" ValueChanged="v => Set(() => file.Password = v)" />
        <p class="hint">Use a secret variable for the password, e.g. <code>{{certPassword}}</code>, so it stays out of Git.</p>
    }
    else if (Settings.ClientCertificate is { Source: ClientCertificateSource.Store } store)
    {
        <label class="field">
            <span>Thumbprint</span>
            <input value="@store.Thumbprint" placeholder="certmgr.msc → Personal → Certificates → Details" spellcheck="false"
                   @oninput="e => Set(() => store.Thumbprint = e.Value?.ToString() ?? string.Empty)" />
        </label>
        <p class="hint">Looked up in CurrentUser\My, then LocalMachine\My. The certificate needs a private key.</p>
    }

    <p class="hint">The proxy is set app-wide in ⚙ Settings.</p>
</div>

@code {
    [Parameter, EditorRequired] public RequestTab Tab { get; set; } = null!;

    private RequestSettings Settings => Tab.Request.Settings;

    private string CertSource => Settings.ClientCertificate?.Source.ToString() ?? "none";

    private void Set(Action change)
    {
        change();
        State.MarkDirty();
    }

    private void OnVersionChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        Set(() => Settings.HttpVersion = value is null or "auto" ? null : value);
    }

    private void OnCertSourceChanged(ChangeEventArgs e) => Set(() =>
        Settings.ClientCertificate = Enum.TryParse<ClientCertificateSource>(e.Value?.ToString(), out var source)
            ? (Settings.ClientCertificate ?? new ClientCertificateSettings()) with { Source = source }
            : null);

    private async Task PickCert()
    {
        if (Settings.ClientCertificate is { } cert && await Platform.PickFileAsync() is { } path) Set(() => cert.FilePath = path);
    }

    private void SetInt(ChangeEventArgs e, Action<int> set)
    {
        if (int.TryParse(e.Value?.ToString(), out var value) && value >= 0) Set(() => set(value));
    }
}
