<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A versioned Windows TFM: the WebView2 composition control needs the Windows SDK projection. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>ApiPin</AssemblyName>
    <RootNamespace>ApiPin.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiPin.UI\ApiPin.UI.csproj" />
  </ItemGroup>

</Project>
