<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A versioned Windows TFM: the WebView2 composition control needs the Windows SDK projection. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>ApiPin</AssemblyName>
    <RootNamespace>ApiPin.Desktop</RootNamespace>
    <!-- Regenerate with tools/icon/make-icon.ps1 -->
    <ApplicationIcon>Assets\apipin.ico</ApplicationIcon>
    <!-- LibraryImport (DWM title bar colours) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\apipin.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiPin.UI\ApiPin.UI.csproj" />
  </ItemGroup>

</Project>
